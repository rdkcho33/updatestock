{
  "name": "updatestock-apify-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3333",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "dev:all": "concurrently \"node server/index.js\" \"vite --host 127.0.0.1 --port 3333\"",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3333"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  }
}
